{
    "name": "minetrax/minetrax",
    "type": "project",
    "description": "MineTrax Web Suite.",
    "keywords": [
        "framework",
        "laravel",
        "minetrax",
        "minecraft"
    ],
    "license": "MIT",
    "require": {
        "php": ">=8.4.1",
        "ext-json": "*",
        "ext-sockets": "*",
        "ext-zip": "*",
        "brick/money": "^0.14.0",
        "clue/socket-raw": "^1.6",
        "cybercog/laravel-love": "^10.0",
        "dompdf/dompdf": "^3.1",
        "geoip2/geoip2": "^3.1",
        "guzzlehttp/guzzle": "^7.4",
        "inertiajs/inertia-laravel": "^3.0",
        "intervention/image-laravel": "^1.3|^4.0",
        "laravel-notification-channels/discord": "^1.6",
        "laravel/ai": "^0.9.0",
        "laravel/framework": "^13.0",
        "laravel/jetstream": "^5.3",
        "laravel/nightwatch": "^1.7",
        "laravel/pulse": "^1.0",
        "laravel/sanctum": "^4.0",
        "laravel/socialite": "^5.5",
        "laravel/telescope": "^5.0",
        "laravel/tinker": "^3.0",
        "league/commonmark": "^2.6",
        "league/flysystem-aws-s3-v3": "^3.29",
        "league/flysystem-ftp": "^3.29",
        "league/flysystem-sftp-v3": "^3.29",
        "league/mime-type-detection": "^1.16",
        "marvinlabs/laravel-discord-logger": "^1.4",
        "nxp/math-executor": "^2.3",
        "predis/predis": "^3.0",
        "pusher/pusher-php-server": "^7.2",
        "socialiteproviders/discord": "^4.2",
        "spatie/laravel-activitylog": "^4.12",
        "spatie/laravel-backup": "^10.0",
        "spatie/laravel-data": "^4.23",
        "spatie/laravel-medialibrary": "^11.10",
        "spatie/laravel-pdf": "^2.12",
        "spatie/laravel-permission": "^8.0",
        "spatie/laravel-query-builder": "^7.0",
        "spatie/laravel-ray": "^1.37",
        "spatie/laravel-searchable": "^1.12",
        "spatie/laravel-settings": "^3.4",
        "spirit55555/php-minecraft": "^1.3|^2.0",
        "stripe/stripe-php": "^21.0",
        "symfony/http-client": "^7.0",
        "symfony/yaml": "^7.0",
        "tightenco/ziggy": "^2.0",
        "torann/geoip": "^3.0",
        "xpaw/php-minecraft-query": "^5.0",
        "xpaw/php-source-query-class": "^4.0|^6.0"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^4.0",
        "barryvdh/laravel-ide-helper": "^3.2",
        "fakerphp/faker": "^1.24",
        "laravel/boost": "^2.0",
        "laravel/pail": "^1.2",
        "laravel/pint": "^1.18",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.8",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-agent": "^5.0",
        "pestphp/pest-plugin-drift": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "rector/rector": "^2.0",
        "spatie/laravel-ignition": "^2.9"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan telescope:publish --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform": {
            "php": "8.4.1"
        },
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "prefer-stable": true,
    "minimum-stability": "beta"
}
